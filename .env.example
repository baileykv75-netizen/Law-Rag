# Law-Rag local configuration template
# Copy values into your local environment or private `.env` workflow.
# Never commit the real `.env` file or API keys.

# Application
LAW_RAG_ENV=development
LAW_RAG_HOST=127.0.0.1
LAW_RAG_BACKEND_PORT=8000
LAW_RAG_FRONTEND_PORT=5173
LAW_RAG_RUNTIME_DIR=runtime

# Stage 8 primary LLM provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Test/development only. Keep disabled for ordinary use.
LAW_RAG_ALLOW_FAKE_AI_PROVIDER=0

# Reserved for later Stage 9 secondary review integrations.
KIMI_API_KEY=
QWEN_API_KEY=
