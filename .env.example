# Law-Rag local configuration template
# Copy this file to `.env` for local development when a later stage requires secrets.
# Never commit the real `.env` file.

# Application
LAW_RAG_ENV=development
LAW_RAG_HOST=127.0.0.1
LAW_RAG_BACKEND_PORT=8000
LAW_RAG_FRONTEND_PORT=5173
LAW_RAG_RUNTIME_DIR=runtime

# External LLM providers (not required in Stage 1)
DEEPSEEK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=

# Provider/model names will be configured only when the corresponding integration stage begins.
