# Law-Rag local configuration template
# Copy values into your local environment or private `.env` workflow.
# Never commit the real `.env` file or API keys.

# Application
LAW_RAG_ENV=development
LAW_RAG_HOST=127.0.0.1
LAW_RAG_BACKEND_PORT=8000
LAW_RAG_FRONTEND_PORT=5173
LAW_RAG_RUNTIME_DIR=runtime

# Stage 8 primary LLM provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Stage 9 universal secondary-review provider (Kimi / Moonshot AI)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k3

# Test/development only. Keep disabled for ordinary use.
LAW_RAG_ALLOW_FAKE_AI_PROVIDER=0
LAW_RAG_ALLOW_FAKE_SECONDARY_PROVIDER=0

# Optional paid/network smoke tests. Keep disabled unless intentionally testing with synthetic/public data.
LAW_RAG_DEEPSEEK_SMOKE=0
LAW_RAG_KIMI_SMOKE=0
